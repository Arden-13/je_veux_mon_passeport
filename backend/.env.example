# 1. Configuration du serveur Express
PORT=3000

# 2. Si le projet utilise le SDK Supabase (@supabase/supabase-js)
SUPABASE_URL=votre_url_projet_supabase
SUPABASE_KEY=votre_cle_anon_publique

# 3. Si le projet attaque directement la base PostgreSQL (ex: via le module 'pg')
DATABASE_URL=postgres://user:password@host:port/db

# 4. Sécurité et Authentification (Middlewares)
JWT_SECRET=votre_phrase_secrete_jwt